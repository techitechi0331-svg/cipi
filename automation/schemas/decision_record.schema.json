{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipi.local/schemas/decision_record.schema.json",
  "title": "CIPI Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "job_id",
    "source_run",
    "event_type",
    "authority",
    "decision",
    "review_status",
    "rationale",
    "retained_findings",
    "reusable_findings",
    "revisit_if",
    "lineage",
    "created_at",
    "immutable"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 5
    },
    "job_id": {
      "type": "string",
      "minLength": 3
    },
    "source_run": {
      "type": "string",
      "pattern": "^research/runs/"
    },
    "event_type": {
      "enum": [
        "AUTOMATED_PROPOSAL",
        "REVIEW"
      ]
    },
    "authority": {
      "enum": [
        "AUTOMATION",
        "HUMAN_REVIEW",
        "ASSISTANT_REVIEW"
      ]
    },
    "decision": {
      "enum": [
        "PROMOTE",
        "ITERATE",
        "ARCHIVE",
        "REJECT"
      ]
    },
    "review_status": {
      "enum": [
        "PENDING",
        "CONFIRMED",
        "SUPERSEDED"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "declared_rejection_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggered_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retained_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reusable_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revisit_if": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_jobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "parent_decision_id": {
      "type": "string"
    },
    "immutable": {
      "const": true
    }
  },
  "additionalProperties": true
}
